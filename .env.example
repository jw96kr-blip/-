# data.go.kr에서 발급받은 디코딩(Decoding) 서비스키를 입력하세요.
# 인코딩 키(URL-encoded)가 아닌 디코딩 키를 사용해야 합니다.

LISTINGS_API_KEY=여기에_분양정보_서비스키_입력
COMPETITION_API_KEY=여기에_경쟁률_서비스키_입력
SUBSCRIPTION_API_KEY=여기에_당첨자_서비스키_입력

# 로컬 개발 시: http://localhost:3000
# Vercel 배포 후: https://your-project.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000
